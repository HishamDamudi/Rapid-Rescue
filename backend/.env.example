PORT=5000
MONGODB_URI=mongodb://localhost:27017/rapidrescue
JWT_SECRET=change-this-to-a-long-random-string


# Push notifications to relatives (optional). Path to the Firebase service-account JSON,
# or the JSON itself. See README_RELATIVES.md. Leave empty to keep push off.
FIREBASE_SERVICE_ACCOUNT=

# ── Emergency workflow tuning (all optional; defaults shown) ──
# AUTO_TRIGGER_GRACE_SEC=20          # sensor-triggered SOS waits this long so the patient can say "I'm fine" (manual SOS = immediate)
# AMBULANCE_MAX_KM=25                # only ambulances within this distance are considered
# VEHICLE_LOCATION_STALE_MIN=10      # ambulances whose app hasn't sent GPS for this long are ignored
# POLICE_RADIUS_KM=20
# HOSPITAL_OFFER_TIMEOUT_SEC=90      # a hospital that doesn't answer in time is skipped
# HOSPITAL_OFFER_COUNT=3             # how many ranked hospitals are lined up
# AMBULANCE_SEARCH_GIVE_UP_MIN=15

# --- automatic pickup / hospital hand-over (all optional) ---
# ARRIVAL_RADIUS_M=10            # ambulance within this distance of the patient = arrived -> patient picked up, nearest hospital allocated
# HOSPITAL_ARRIVAL_RADIUS_M=50   # ambulance within this distance of the hospital = reached hospital
# ARRIVAL_MAX_ACCURACY_M=25      # ignore GPS fixes less accurate than this
# ARRIVAL_CONFIRM_FIXES=2        # consecutive fixes inside the radius needed (filters GPS spikes)
